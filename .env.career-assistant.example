# 求职助手本机开发 PostgreSQL。复制为 .env.career-assistant 后再按需修改。
ZHITAN_ENV_FILE=.env.career-assistant
PLATFORM_ADMIN_EMAIL=admin@example.com
CAREER_POSTGRES_DB=career_assistant
CAREER_POSTGRES_USER=career_assistant
CAREER_POSTGRES_PASSWORD=change-me-before-production
CAREER_POSTGRES_PORT=54329
CAREER_DATABASE_URL=postgresql+psycopg://career_assistant:change-me-before-production@127.0.0.1:54329/career_assistant
PREVIEW_SERVER_PORT=18080
VITE_PORT=5173
VITE_API_PROXY_TARGET=http://127.0.0.1:18080

# 可选：显式覆盖自动托管的 Fernet 主密钥。留空时服务会在 data/career_credential_master.key
# 自动创建并复用一把密钥；不能复用数据库密码或任意模型 API Key。
CAREER_CREDENTIAL_MASTER_KEY=
# 可选：将自动托管主密钥文件放到其他持久化目录；相对路径基于项目根目录。
CAREER_CREDENTIAL_KEY_FILE=
# 仅用于迁移历史 plaintext_api_key 的本地临时兼容开关；生产环境保持 false 或不设置。
CAREER_ALLOW_LEGACY_PLAINTEXT_CREDENTIALS=false

# 已配置的付费模型和本地 Ollama 档案默认允许使用；不会在启动时自动调用模型。
CAREER_ALLOW_PAID_PROFILES=true
CAREER_ENABLE_LOCAL_OLLAMA_PROFILE=true

# 全网公开面经收集。Key 只放本地环境文件或部署平台 Secret，不进入前端和数据库。
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev

# 平台登录邮箱验证码。注册 Resend 并验证发件域名后填写；绝不放到前端或提交进 Git。
# resend.dev 测试域仅能向 Resend 账户邮箱发送测试信，QQ 等真实邮箱必须使用已验证的自有域名发件地址。
# PLATFORM_EMAIL_CODE_SECRET 用于 HMAC 化六位验证码，建议使用至少 32 字节的随机字符串。
PLATFORM_EMAIL_CODE_SECRET=replace-with-another-long-random-secret
RESEND_API_KEY=
RESEND_FROM_ADDRESS=职业智能工作台 <no-reply@your-verified-domain.example>

# 兼容早期环境变量配置的免费额度 Provider。新的模型连接也可直接在页面填写 API Key，
# 系统会用上方主密钥加密后保存到 PostgreSQL。
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
MODELSCOPE_API_KEY=
BAIDU_QIANFAN_API_KEY=
HUNYUAN_API_KEY=
DASHSCOPE_API_KEY=
# 面试大师默认使用 Qwen-Audio 流式转写；通常只需填写上面的 Key。
DASHSCOPE_ASR_MODEL=qwen-audio-3.0-asr-flash-streaming
DASHSCOPE_ASR_WEBSOCKET_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
DASHSCOPE_WORKSPACE_ID=
NVIDIA_API_KEY=
TOKENHUB_API_KEY=
SILICONFLOW_API_KEY=
ZHIPUAI_API_KEY=
MINIMAX_API_KEY=
VOLCENGINE_ARK_API_KEY=

# 可选：Docling 文档解析服务启用 X-Api-Key 鉴权时才需要。
# 同时需在 config/career_assistant.yaml 中填入相同的环境变量名并启用服务。
CAREER_DOCLING_API_KEY=

# 独立 Docling 服务的本机资源配置。GPU 服务默认只并发一个解析任务，避免和日常使用抢显存。
 # 默认使用 RTX 5070 的 CUDA 路径；仅在 Docker GPU 运行时明确故障时才临时设为 cpu。
DOCLING_DEVICE=cuda
DOCLING_SERVE_PORT=5001
DOCLING_SERVE_WORKERS=1
DOCLING_SERVE_MAX_NUM_PAGES=90
DOCLING_SERVE_MAX_FILE_SIZE=10485760

# 可选：观测求职 Agent、视觉解析和面经库链路。
# 输入输出可能包含简历、职位、面经和聊天正文，因此必须保持隐藏。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=your-langsmith-project
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
