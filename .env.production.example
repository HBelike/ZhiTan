# 此文件只提供变量名和示例，不要提交真实密钥；复制为 .env.production 后填写并 chmod 600。
# 公网入口由 Docker 内 Caddy 统一提供 HTTPS。APP_DOMAIN 只填域名，不带 https://。
APP_DOMAIN=app.example.com
ZHITAN_ENV_FILE=.env.production
# 打包浏览器扩展时使用的无路径 HTTPS Origin。
ZHITAN_APP_ORIGIN=https://app.example.com

# 生产安全开关：所有 /api 业务接口必须登录。公开注册策略默认开启，但只有邮箱 Provider
# 配置完整时才会显示验证码注册；新注册用户固定是 user。封闭部署可显式改为 false。
# 唯一管理员邮箱由环境变量配置，只能通过受控 bootstrap 创建。
PLATFORM_AUTH_REQUIRED=true
PLATFORM_PUBLIC_REGISTRATION_ENABLED=true
PLATFORM_ADMIN_EMAIL=admin@example.com
# 首个管理员仅允许通过服务器交互式命令创建，避免未初始化平台被公网邮箱抢先注册。
PLATFORM_CLI_BOOTSTRAP_ONLY=true

# PostgreSQL：请替换为长随机密码。数据库不会暴露宿主机端口。
CAREER_POSTGRES_DB=career_assistant
CAREER_POSTGRES_USER=career_assistant
CAREER_POSTGRES_PASSWORD=replace-with-a-long-random-password

# 页面保存的聊天模型 Key 由 Fernet 主密钥在服务端加密。可选：显式 Secret；留空时 API
# 会在 application_data 持久化卷自动创建并复用主密钥。不能与数据库密码相同，也不要在
# Git、日志或浏览器中暴露。
CAREER_CREDENTIAL_MASTER_KEY=
# 可选：自动托管主密钥文件的位置；默认 /app/data/career_credential_master.key。
CAREER_CREDENTIAL_KEY_FILE=
# 仅用于旧 plaintext_api_key 的本地短期迁移。生产环境必须保持 false 或不设置。
CAREER_ALLOW_LEGACY_PLAINTEXT_CREDENTIALS=false

# 已由部署者配置的付费模型和本地 Ollama 档案默认允许使用；不会在启动时自动调用模型。
CAREER_ALLOW_PAID_PROFILES=true
CAREER_ENABLE_LOCAL_OLLAMA_PROFILE=true

# 按产品要求保留完整的用户输入和附件解析文本；附件原件只保存在 API 容器 tmpfs，
# 完成解析并写入 PostgreSQL 后立即删除，不进入 Worker 容器。
CAREER_REDACTION_ENABLED=false

# 求职助手 Turn 队列：同一会话串行，不同会话并发。全局并发是所有 Worker 副本共享的
# LLM/Tool 执行上限；单 Worker 并发不要高于全局并发。
CAREER_AGENT_WORKER_ID=career-agent-worker
CAREER_AGENT_GLOBAL_CONCURRENCY=8
CAREER_AGENT_WORKER_CONCURRENCY=4
CAREER_AGENT_LEASE_SECONDS=90
CAREER_AGENT_HEARTBEAT_SECONDS=20
CAREER_AGENT_EVENT_POLL_MILLISECONDS=300

# 无 GPU 服务器也可以启用 CPU Docling。初次启用会拉取较大的解析镜像，建议保持
# 单 worker、单线程起步，并在 4 核 / 8GB 机器上先用真实中文 PDF 与图片验收。
# 启动：docker compose --env-file .env.production -f docker-compose.production.yml
#       --profile document-processing up -d career-docling career-api pipeline-scheduler
CAREER_DOCLING_ENABLED=false
DOCLING_CPU_THREADS=1
DOCLING_SERVE_WORKERS=1
DOCLING_SERVE_MAX_NUM_PAGES=90
DOCLING_SERVE_MAX_FILE_SIZE=10485760

# Gotenberg 用于旧版 DOC/XLS 转 PDF；关闭时旧版 Office 文件会得到明确提示。
CAREER_GOTENBERG_ENABLED=true

# 面经库“全网公开信息收集”使用 Firecrawl /search 发现页面，再用 /scrape 提取正文。
# Key 只写入服务器本地 .env.production，不进入 Git、日志或浏览器。
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev

# 平台账号邮箱验证。生产首个管理员由服务器 CLI 初始化；以下配置用于注册、邮箱绑定和密码找回。
# Resend 的 resend.dev 仅能向 Resend 账户自身邮箱投递，不能用于 QQ 等真实收件人；
# 请先在 Resend 验证自己的发件域名并配置 SPF、DKIM，再填写该域名下的发件地址。
PLATFORM_EMAIL_CODE_SECRET=
RESEND_API_KEY=
RESEND_FROM_ADDRESS=职业智能工作台 <no-reply@your-verified-domain.example>

# 平台固定图片理解能力：填入阿里云百炼的 API Key 与工作空间 OpenAI-compatible Host。
# 该模型不出现在聊天模型下拉框，也不会被返回给浏览器。
CAREER_DOCUMENT_VISION_API_KEY=
CAREER_DOCUMENT_VISION_BASE_URL=

# GitHub 周榜、公众号草稿与内容生成。微信出口白名单须添加香港服务器的固定公网 IP。
GITHUB_TOKEN=
DEEPSEEK_API_KEY=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_AUTHOR=
WECHAT_CONTENT_SOURCE_URL=

# 周榜音视频生成当前完全关闭；生产环境保持 false，避免产生 Seedance 与 TTS 费用。
VIDEO_SUBMIT_ENABLED=false
AUDIO_ENABLED=false
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_VOICE_TYPE=
# 使用本地公开媒体时，填写带 /media 的正式 HTTPS 域名；Caddy 仅服务 outputs/public。
STORAGE_LOCAL_PUBLIC_BASE_URL=https://your-domain.example/media
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# 可选：默认模型网关凭证。通过页面保存的模型连接会优先使用其自身保存的 Key。
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
MODELSCOPE_API_KEY=
BAIDU_QIANFAN_API_KEY=
HUNYUAN_API_KEY=
DASHSCOPE_API_KEY=
NVIDIA_API_KEY=
TOKENHUB_API_KEY=
SILICONFLOW_API_KEY=
ZHIPUAI_API_KEY=
MINIMAX_API_KEY=
VOLCENGINE_ARK_API_KEY=

# 可选：面经库语义检索。默认关闭；启用前确认 embedding 模型输出 1024 维，
# 并填写对应 OpenAI-compatible Base URL。鉴权复用上方 DASHSCOPE_API_KEY。
CAREER_INTERVIEW_EMBEDDING_ENABLED=false
CAREER_INTERVIEW_EMBEDDING_MODEL_ID=
CAREER_INTERVIEW_EMBEDDING_BASE_URL=

# 可选：LangSmith 只上传脱敏元数据；面经向量化与云端视觉能力按 config/career_assistant.yaml 使用。
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=your-langsmith-project
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
LANGSMITH_UI_URL=https://smith.langchain.com
