{
  "name": "windows-live-interview-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Windows 双音轨实时面试助手",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --port 5174\" \"wait-on tcp:5174 && cross-env VITE_DEV_SERVER_URL=http://localhost:5174 electron .\"",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "build": "vite build && tsc -p electron/tsconfig.json",
    "start": "electron ."
  },
  "dependencies": {
    "vue": "3.5.41",
    "vue-router": "4.6.3",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-vue": "6.0.4",
    "concurrently": "9.2.4",
    "cross-env": "10.1.0",
    "electron": "43.4.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "vue-tsc": "3.1.3",
    "wait-on": "9.0.3"
  }
}
