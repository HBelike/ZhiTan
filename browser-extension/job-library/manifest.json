{
  "manifest_version": 3,
  "name": "ZhiTan Browser Assistant",
  "version": "0.3.2",
  "description": "读取用户主动选择的职位、公开面经或当前笔试题面；线上笔试功能仅分析，不自动填写或提交。",
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://www.zhipin.com/*",
    "https://www.xiaohongshu.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "识别当前线上笔试题目"
  }
}
