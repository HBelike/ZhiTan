APP_RUN_MODE=once

# 平台唯一管理员邮箱。部署前替换为实际管理员地址。
PLATFORM_ADMIN_EMAIL=admin@example.com

# 求职助手独立 PostgreSQL。请在本地复制到 .env 后替换生产密码。
CAREER_POSTGRES_DB=career_assistant
CAREER_POSTGRES_USER=career_assistant
CAREER_POSTGRES_PASSWORD=change-me-before-production
CAREER_POSTGRES_PORT=54329
CAREER_DATABASE_URL=postgresql+psycopg://career_assistant:change-me-before-production@127.0.0.1:54329/career_assistant

# 云端免费模型的 Key 只由服务端读取，永不写入数据库或返回浏览器。
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GITHUB_TOKEN=
DEEPSEEK_API_KEY=
# 面试大师实时转写：在阿里云百炼华北2（北京）创建 Key 后填写。
DASHSCOPE_API_KEY=
DASHSCOPE_ASR_MODEL=qwen-audio-3.0-asr-flash-streaming
DASHSCOPE_ASR_WEBSOCKET_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
# 使用非默认业务空间时填写；默认业务空间保持为空。
DASHSCOPE_WORKSPACE_ID=
VOLCENGINE_ARK_API_KEY=
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_VOICE_TYPE=
SEEDANCE_API_KEY=
STORAGE_LOCAL_PUBLIC_BASE_URL=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_BASE_URL=
VOLCENGINE_TOS_ENDPOINT=
VOLCENGINE_TOS_REGION=
VOLCENGINE_TOS_BUCKET=
VOLCENGINE_TOS_ACCESS_KEY_ID=
VOLCENGINE_TOS_SECRET_ACCESS_KEY=
VOLCENGINE_TOS_PUBLIC_BASE_URL=
TENCENT_COS_REGION=
TENCENT_COS_BUCKET=
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_PUBLIC_BASE_URL=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_AUTHOR=
WECHAT_CONTENT_SOURCE_URL=

# 可选：LangSmith 链路观测。保持请求和响应正文隐藏，只上传脱敏元数据。
# 填写项目专用 API Key 后，再将 LANGSMITH_TRACING 改为 true。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=your-langsmith-project
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
