ZHITAN_HTTP_PORT=18081
ZHITAN_ENV_FILE=.env.quickstart
CAREER_POSTGRES_DB=zhitan
CAREER_POSTGRES_USER=zhitan
CAREER_POSTGRES_PASSWORD=replace-with-setup-generated-value
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_EMAIL_CODE_SECRET=replace-with-setup-generated-value
PLATFORM_AUTH_REQUIRED=true
PLATFORM_PUBLIC_REGISTRATION_ENABLED=false
PLATFORM_CLI_BOOTSTRAP_ONLY=true
# 可选：三项完整配置后，验证码登录、公开注册和密码找回才会显示。
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
