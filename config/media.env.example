# 复制需要的变量到项目根目录 .env；不要提交真实凭证。

# 火山方舟：Seedream 生图与 Seedance 视频
VOLCENGINE_ARK_API_KEY=

# 豆包语音 V3：生产旁白。此 Key 必须在“豆包语音”控制台创建，不能使用方舟 ARK Key。
DOUBAO_TTS_API_KEY=
# 可选：未填写则使用 config/app.yaml 的默认音色
DOUBAO_TTS_VOICE_TYPE=

# Cloudflare R2：Seedance 必须能访问公开的图片 URL
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# 仅本地公开服务真实可被互联网访问时才可使用；127.0.0.1 无法提供给 Seedance。
STORAGE_LOCAL_PUBLIC_BASE_URL=
